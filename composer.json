{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "uigenesis/app",
  "type": "project",
  "description": "UIGenesis Laravel 12 application",
  "keywords": ["laravel", "uigenesis"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "require-dev": {},
  "autoload": {
    "psr-4": { "App\\": "app/" }
  },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": { "php-http/discovery": true }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

APP_NAME=UIGenesis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uigenesis
DB_USERNAME=root
DB_PASSWORD=

# Default local mode writes verification links to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@uigenesis.local
MAIL_FROM_NAME="UIGenesis"

# To send verification emails through Gmail locally, replace the settings above:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-address@gmail.com
# MAIL_PASSWORD=your-16-character-google-app-password
# MAIL_FROM_ADDRESS=your-address@gmail.com
# MAIL_FROM_NAME="UIGenesis"

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
